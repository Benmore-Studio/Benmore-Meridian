class UserSessionSerializer(serializers.ModelSerializer):
    """
    User session serializer for viewing active sessions
    """
    user_email = serializers.CharField(source='user.email', read_only=True)
    is_current = serializers.SerializerMethodField()

    class Meta:
        model = UserSession
        fields = [
            'id', 'user', 'user_email', 'device_name', 'device_id',
            'platform', 'ip_address', 'is_active', 'is_current',
            'created_at', 'last_used', 'expires_at'
        ]
        read_only_fields = fields

    def get_is_current(self, obj):
        """Check if this is the current session"""
        request = self.context.get('request')
        if request and hasattr(request, 'auth'):
            # Compare JWT IDs if available
            current_jti = request.auth.get('jti', '')
            return obj.access_token_jti == current_jti
        return False


class SocialAccountSerializer(serializers.ModelSerializer):
    """
    Social account serializer for OAuth connections
    """
    provider_display = serializers.SerializerMethodField()

    class Meta:
        model = SocialAccount
        fields = [
            'id', 'provider', 'provider_display', 'uid',
            'is_active', 'created_at', 'last_login'
        ]
        read_only_fields = fields

    def get_provider_display(self, obj):
        """Get human-readable provider name"""
        provider_names = {
            'google': 'Google',
            'facebook': 'Facebook',
            'apple': 'Apple',
            'github': 'GitHub',
            'twitter': 'Twitter',
            'linkedin': 'LinkedIn'
        }
        return provider_names.get(obj.provider, obj.provider.title())


