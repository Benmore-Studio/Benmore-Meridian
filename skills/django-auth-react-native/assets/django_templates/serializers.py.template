class InviteUserSerializer(serializers.Serializer):
    """
    Serializer for inviting users to organization
    """
    email = serializers.EmailField(required=True)
    role = serializers.ChoiceField(
        choices=['manager', 'employee', 'customer'],
        required=True
    )
    first_name = serializers.CharField(required=False, allow_blank=True)
    last_name = serializers.CharField(required=False, allow_blank=True)
    send_email = serializers.BooleanField(default=True)

    def validate_email(self, value):
        """Check if user already exists"""
        email = value.lower().strip()
        if User.objects.filter(email=email).exists():
            raise serializers.ValidationError("A user with this email already exists.")
        return email


class BulkInviteSerializer(serializers.Serializer):
    """
    Serializer for bulk user invitations
    """
    invitations = InviteUserSerializer(many=True)
    send_emails = serializers.BooleanField(default=True)

    def validate_invitations(self, value):
        """Validate all invitations"""
        if len(value) > 100:  # Limit bulk invites
            raise serializers.ValidationError("Cannot invite more than 100 users at once.")

        # Check for duplicate emails
        emails = [inv['email'].lower() for inv in value]
        if len(emails) != len(set(emails)):
            raise serializers.ValidationError("Duplicate email addresses found in invitations.")

        return value


class UpdateUserRoleSerializer(serializers.Serializer):
    """
    Serializer for updating user role
    """
    role = serializers.ChoiceField(
        choices=['admin', 'manager', 'employee', 'customer'],
        required=True
    )

    def validate_role(self, value):
        """Validate role change"""
        user = self.context.get('user')
        requester = self.context.get('request').user

        # Prevent demoting yourself
        if user == requester and value != user.role:
            if user.role == 'admin' and value != 'admin':
                raise serializers.ValidationError("You cannot demote yourself from admin.")

        return value


class UserActivationSerializer(serializers.Serializer):
    """
    Serializer for activating/deactivating users
    """
    is_active = serializers.BooleanField(required=True)
    reason = serializers.CharField(required=False, allow_blank=True)

    def validate(self, attrs):
        """Validate activation status change"""
        user = self.context.get('user')
        requester = self.context.get('request').user

        # Prevent deactivating yourself
        if user == requester and not attrs['is_active']:
            raise serializers.ValidationError("You cannot deactivate your own account.")

        return attrs