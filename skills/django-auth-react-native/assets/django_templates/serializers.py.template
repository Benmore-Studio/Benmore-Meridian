User = get_user_model()


class OrganizationSerializer(serializers.ModelSerializer):
    """
    Organization serializer for multi-tenant support
    """
    owner_name = serializers.CharField(source='owner.full_name', read_only=True)
    member_count = serializers.IntegerField(read_only=True)

    class Meta:
        model = Organization
        fields = [
            'id', 'name', 'slug', 'description', 'logo',
            'website', 'contact_email', 'contact_phone',
            'address', 'settings', 'plan', 'is_active',
            'owner', 'owner_name', 'member_count',
            'created_at', 'updated_at'
        ]
        read_only_fields = ['id', 'slug', 'owner_name', 'member_count', 'created_at', 'updated_at']

    def validate_name(self, value):
        """Ensure organization name is unique"""
        if Organization.objects.filter(name__iexact=value).exists():
            raise serializers.ValidationError("An organization with this name already exists.")
        return value


class UserProfileSerializer(serializers.ModelSerializer):
    """
    User profile serializer for reading and updating user information
    """
    full_name = serializers.CharField(read_only=True)
    organization_name = serializers.CharField(
        source='organization.name',
        read_only=True,
        allow_null=True
    )
    role_display = serializers.CharField(
        source='get_role_display',
        read_only=True
    )

    class Meta:
        model = User
        fields = [
            'id', 'email', 'first_name', 'last_name', 'full_name',
            'phone_number', 'profile_picture', 'role', 'role_display',
            'organization', 'organization_name', 'is_verified',
            'is_active', 'is_admin', 'is_manager', 'can_manage_users',
            'last_login', 'created_at', 'updated_at'
        ]
        read_only_fields = [
            'id', 'email', 'role', 'organization', 'is_verified',
            'is_active', 'is_admin', 'is_manager', 'can_manage_users',
            'last_login', 'created_at', 'updated_at'
        ]

    def validate_phone_number(self, value):
        """Validate phone number format"""
        if value:
            # Remove all non-digit characters
            digits = re.sub(r'\D', '', value)
            if len(digits) < 10:
                raise serializers.ValidationError("Phone number must be at least 10 digits.")
            # Format the phone number
            return digits
        return value


class UserRegistrationSerializer(serializers.ModelSerializer):
    """
    User registration serializer with password confirmation
    """
    email = serializers.EmailField(
        required=True,
        validators=[UniqueValidator(
            queryset=User.objects.all(),
            message="A user with this email already exists."
        )]
    )
    password = serializers.CharField(
        write_only=True,
        required=True,
        style={'input_type': 'password'},
        validators=[validate_password]
    )
    password_confirm = serializers.CharField(
        write_only=True,
        required=True,
        style={'input_type': 'password'}
    )

    # Optional organization creation for admin users
    create_organization = serializers.BooleanField(
        write_only=True,
        required=False,
        default=False
    )
    organization_name = serializers.CharField(
        write_only=True,
        required=False,
        allow_blank=True
    )

    class Meta:
        model = User
        fields = [
            'email', 'password', 'password_confirm',
            'first_name', 'last_name', 'phone_number',
            'role', 'create_organization', 'organization_name'
        ]

    def validate(self, attrs):
        """Validate registration data"""
        # Check password match
        if attrs['password'] != attrs['password_confirm']:
            raise serializers.ValidationError({
                'password_confirm': "Passwords do not match."
            })

        # Validate role (only certain roles can self-register)
        allowed_roles = ['customer', 'admin']  # Customize based on your needs
        role = attrs.get('role', 'customer')
        if role not in allowed_roles:
            raise serializers.ValidationError({
                'role': f"Invalid role for registration. Allowed roles: {', '.join(allowed_roles)}"
            })

        # If creating organization, require organization name
        if attrs.get('create_organization') and not attrs.get('organization_name'):
            raise serializers.ValidationError({
                'organization_name': "Organization name is required when creating an organization."
            })

        return attrs

    @transaction.atomic
    def create(self, validated_data):
        """Create user and optionally organization"""
        # Remove non-model fields
        validated_data.pop('password_confirm')
        create_organization = validated_data.pop('create_organization', False)
        organization_name = validated_data.pop('organization_name', None)

        # Create user
        password = validated_data.pop('password')
        user = User.objects.create_user(
            password=password,
            **validated_data
        )

        # Create organization if requested (for admin users)
        if create_organization and user.role == 'admin' and organization_name:
            from django.utils.text import slugify
            organization = Organization.objects.create(
                name=organization_name,
                slug=slugify(organization_name),
                owner=user
            )
            user.organization = organization
            user.save()

        return user


