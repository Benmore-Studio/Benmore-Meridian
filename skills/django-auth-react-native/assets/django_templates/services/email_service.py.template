    def _send_email_with_template(
        self,
        subject: str,
        recipient_email: str,
        template_name: str,
        context: Dict[str, Any]
    ) -> bool:
        """
        Send email using template

        Args:
            subject: Email subject
            recipient_email: Recipient email address
            template_name: Name of the template (without extension)
            context: Context for template rendering

        Returns:
            Boolean indicating if email was sent successfully
        """
        try:
            # Try to render HTML template
            try:
                html_content = render_to_string(f'emails/{template_name}.html', context)
                text_content = strip_tags(html_content)
            except:
                # Fallback to inline template
                html_content = self._get_default_html_template(template_name, context)
                text_content = self._get_default_text_template(template_name, context)

            # Create email message
            email = EmailMultiAlternatives(
                subject=subject,
                body=text_content,
                from_email=self.from_email,
                to=[recipient_email]
            )

            # Attach HTML version
            if html_content:
                email.attach_alternative(html_content, "text/html")

            # Send email
            email.send(fail_silently=False)

            logger.info(f"Email sent successfully to {recipient_email} - Template: {template_name}")
            return True

        except Exception as e:
            logger.error(f"Failed to send email to {recipient_email}: {str(e)}")
            return False

