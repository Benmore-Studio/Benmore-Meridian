"""
OTP Service for email verification and password reset
Handles OTP generation, validation, and rate limiting
"""
import secrets
from datetime import timedelta
from django.core.cache import cache
from django.utils import timezone
from django.db import transaction
from typing import Optional, Tuple
import logging

from ..models import OTPVerification, User
from .email_service import EmailService

logger = logging.getLogger(__name__)


class OTPService:
    """
    Service for handling OTP operations with security features
    """

    # Configuration constants
    OTP_LENGTH = 6
    OTP_EXPIRY_MINUTES = 10
    MAX_ATTEMPTS = 3
    RESEND_COOLDOWN_SECONDS = 120  # 2 minutes
    MAX_OTPS_PER_HOUR = 5
    MAX_OTPS_PER_IP_PER_HOUR = 10

    def __init__(self):
        self.email_service = EmailService()

    @staticmethod
    def generate_otp_code() -> str:
        """
        Generate a cryptographically secure 6-digit OTP
        """
        return str(secrets.randbelow(900000) + 100000)

    @transaction.atomic
    def generate_and_send_otp(
        self,
        user: User,
        purpose: str,
        request=None
    ) -> Optional[OTPVerification]:
        """
        Generate OTP and send via email

        Args:
            user: User instance
            purpose: Purpose of OTP (email_verification, password_reset, etc.)
            request: HTTP request object for IP tracking

        Returns:
            OTPVerification instance or None if rate limited
        """
        # Check rate limiting
        if not self._check_rate_limit(user, purpose, request):
            logger.warning(f"Rate limit exceeded for user {user.email}")
            return None

        # Invalidate any existing unused OTPs for this purpose
        OTPVerification.objects.filter(
            user=user,
            purpose=purpose,
            is_used=False,
            expires_at__gt=timezone.now()
        ).update(
            is_used=True,
            metadata={'invalidated_by': 'new_otp_generation'}
        )

        # Generate new OTP
        otp_code = self.generate_otp_code()
        expires_at = timezone.now() + timedelta(minutes=self.OTP_EXPIRY_MINUTES)

        # Get IP address if request provided
        ip_address = None
        if request:
            ip_address = self._get_client_ip(request)

        # Create OTP record
        otp = OTPVerification.objects.create(
            user=user,
            otp_code=otp_code,
            purpose=purpose,
            expires_at=expires_at,
            ip_address=ip_address,
            max_attempts=self.MAX_ATTEMPTS
        )

        # Send email based on purpose
        email_sent = self._send_otp_email(user, otp_code, purpose, expires_at)

        if not email_sent:
            logger.error(f"Failed to send OTP email to {user.email}")
            otp.delete()  # Remove OTP if email fails
            return None

        # Track OTP generation for rate limiting
        self._track_otp_generation(user, purpose, request)

        logger.info(f"OTP generated for {user.email} - purpose: {purpose}")
        return otp

    def verify_otp(
        self,
        user: User,
        otp_code: str,
        purpose: str,
        mark_as_used: bool = True
    ) -> bool:
        """
        Verify an OTP code

        Args:
            user: User instance
            otp_code: The OTP code to verify
            purpose: Purpose of OTP
            mark_as_used: Whether to mark OTP as used after verification

        Returns:
            Boolean indicating if OTP is valid
        """
        try:
            # Find the most recent valid OTP
            otp = OTPVerification.objects.filter(
                user=user,
                purpose=purpose,
                is_used=False,
                expires_at__gt=timezone.now()
            ).order_by('-created_at').first()

            if not otp:
                logger.warning(f"No valid OTP found for {user.email} - purpose: {purpose}")
                return False

            # Check if max attempts exceeded
            if otp.attempts >= otp.max_attempts:
                logger.warning(f"Max attempts exceeded for OTP {otp.id}")
                return False

            # Increment attempts
            otp.attempts += 1

            # Verify OTP code
            if otp.otp_code == otp_code:
                if mark_as_used:
                    otp.is_used = True
                    otp.verified_at = timezone.now()
                otp.save()

                logger.info(f"OTP verified successfully for {user.email} - purpose: {purpose}")
                return True
            else:
                otp.save()  # Save incremented attempts
                logger.warning(f"Invalid OTP attempt for {user.email} - attempt {otp.attempts}/{otp.max_attempts}")
                return False

        except Exception as e:
            logger.error(f"OTP verification error: {str(e)}")
            return False

    def can_resend_otp(self, user: User, purpose: str) -> Tuple[bool, int]:
        """
        Check if user can request a new OTP

        Args:
            user: User instance
            purpose: Purpose of OTP

        Returns:
            Tuple of (can_resend, wait_seconds)
        """
        # Check last OTP creation time
        cache_key = f"otp_resend_{user.id}_{purpose}"
        last_sent = cache.get(cache_key)

        if last_sent:
            time_passed = (timezone.now() - last_sent).total_seconds()
            if time_passed < self.RESEND_COOLDOWN_SECONDS:
                wait_seconds = int(self.RESEND_COOLDOWN_SECONDS - time_passed)
                return False, wait_seconds

        return True, 0

    def cleanup_expired_otps(self) -> int:
        """
        Clean up expired OTP records
        This should be run periodically (e.g., via Celery beat)

        Returns:
            Number of OTPs deleted
        """
        expired_otps = OTPVerification.objects.filter(
            expires_at__lt=timezone.now() - timedelta(days=1)
        )
        count = expired_otps.count()
        expired_otps.delete()

        logger.info(f"Cleaned up {count} expired OTP records")
        return count

    def _check_rate_limit(self, user: User, purpose: str, request=None) -> bool:
        """
        Check if user has exceeded rate limits

        Returns:
            Boolean indicating if action is allowed
        """
        # User-based rate limiting
        user_key = f"otp_rate_user_{user.id}"
        user_count = cache.get(user_key, 0)

        if user_count >= self.MAX_OTPS_PER_HOUR:
            return False

        # IP-based rate limiting (if request provided)
        if request:
            ip_address = self._get_client_ip(request)
            ip_key = f"otp_rate_ip_{ip_address}"
            ip_count = cache.get(ip_key, 0)

            if ip_count >= self.MAX_OTPS_PER_IP_PER_HOUR:
                return False

        return True

    def _track_otp_generation(self, user: User, purpose: str, request=None):
        """
        Track OTP generation for rate limiting
        """
        # Track user-based rate limit
        user_key = f"otp_rate_user_{user.id}"
        user_count = cache.get(user_key, 0)
        cache.set(user_key, user_count + 1, 3600)  # 1 hour expiry

        # Track IP-based rate limit
        if request:
            ip_address = self._get_client_ip(request)
            ip_key = f"otp_rate_ip_{ip_address}"
            ip_count = cache.get(ip_key, 0)
            cache.set(ip_key, ip_count + 1, 3600)

        # Track last sent time for cooldown
        cache_key = f"otp_resend_{user.id}_{purpose}"
        cache.set(cache_key, timezone.now(), self.RESEND_COOLDOWN_SECONDS)

    def _send_otp_email(
        self,
        user: User,
        otp_code: str,
        purpose: str,
        expires_at
    ) -> bool:
        """
        Send OTP via email based on purpose

        Returns:
            Boolean indicating if email was sent successfully
        """
        if purpose == 'email_verification':
            return self.email_service.send_email_verification(
                user=user,
                otp_code=otp_code,
                expires_at=expires_at
            )
        elif purpose == 'password_reset':
            return self.email_service.send_password_reset(
                user=user,
                otp_code=otp_code,
                expires_at=expires_at
            )
        elif purpose == 'login_verification':
            return self.email_service.send_login_verification(
                user=user,
                otp_code=otp_code,
                expires_at=expires_at
            )
        else:
            logger.error(f"Unknown OTP purpose: {purpose}")
            return False

    def _get_client_ip(self, request) -> str:
        """
        Extract client IP from request
        """
        x_forwarded_for = request.META.get('HTTP_X_FORWARDED_FOR')
        if x_forwarded_for:
            return x_forwarded_for.split(',')[0].strip()
        return request.META.get('REMOTE_ADDR', '')

    def get_otp_status(self, user: User, purpose: str) -> dict:
        """
        Get current OTP status for user

        Returns:
            Dictionary with OTP status information
        """
        # Find active OTP
        otp = OTPVerification.objects.filter(
            user=user,
            purpose=purpose,
            is_used=False,
            expires_at__gt=timezone.now()
        ).order_by('-created_at').first()

        if not otp:
            return {
                'has_active_otp': False,
                'can_resend': True,
                'wait_seconds': 0
            }

        # Check resend status
        can_resend, wait_seconds = self.can_resend_otp(user, purpose)

        return {
            'has_active_otp': True,
            'attempts_remaining': max(0, otp.max_attempts - otp.attempts),
            'expires_at': otp.expires_at,
            'can_resend': can_resend,
            'wait_seconds': wait_seconds
        }


class RateLimitService:
    """
    Service for handling rate limiting across the application
    """

    # Rate limit configurations
    LOGIN_ATTEMPTS_PER_HOUR = 5
    LOGIN_ATTEMPTS_PER_IP_PER_HOUR = 10
    PASSWORD_RESET_PER_HOUR = 3
    PASSWORD_RESET_PER_IP_PER_HOUR = 5

    def check_login_attempt(self, email: str, ip_address: str) -> bool:
        """
        Check if login attempt is allowed

        Returns:
            Boolean indicating if attempt is allowed
        """
        # Email-based rate limiting
        email_key = f"login_attempts_{email}"
        email_count = cache.get(email_key, 0)

        if email_count >= self.LOGIN_ATTEMPTS_PER_HOUR:
            return False

        # IP-based rate limiting
        ip_key = f"login_attempts_ip_{ip_address}"
        ip_count = cache.get(ip_key, 0)

        if ip_count >= self.LOGIN_ATTEMPTS_PER_IP_PER_HOUR:
            return False

        # Increment counters
        cache.set(email_key, email_count + 1, 3600)
        cache.set(ip_key, ip_count + 1, 3600)

        return True

    def check_password_reset_request(self, email: str, ip_address: str) -> bool:
        """
        Check if password reset request is allowed

        Returns:
            Boolean indicating if request is allowed
        """
        # Email-based rate limiting
        email_key = f"password_reset_{email}"
        email_count = cache.get(email_key, 0)

        if email_count >= self.PASSWORD_RESET_PER_HOUR:
            return False

        # IP-based rate limiting
        ip_key = f"password_reset_ip_{ip_address}"
        ip_count = cache.get(ip_key, 0)

        if ip_count >= self.PASSWORD_RESET_PER_IP_PER_HOUR:
            return False

        # Increment counters
        cache.set(email_key, email_count + 1, 3600)
        cache.set(ip_key, ip_count + 1, 3600)

        return True

    def clear_rate_limits(self, email: str = None, ip_address: str = None):
        """
        Clear rate limits (useful for testing or admin actions)
        """
        if email:
            cache.delete_many([
                f"login_attempts_{email}",
                f"password_reset_{email}",
                f"otp_rate_user_{email}"
            ])

        if ip_address:
            cache.delete_many([
                f"login_attempts_ip_{ip_address}",
                f"password_reset_ip_{ip_address}",
                f"otp_rate_ip_{ip_address}"
            ])